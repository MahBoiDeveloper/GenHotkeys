#include "Info.hpp"

IDI_ICON1	ICON	DISCARDABLE	"EditorIcon.ico"

1 VERSIONINFO
FILEVERSION     GENHOTKEYS_RESOURCE_VERSION
PRODUCTVERSION  GENHOTKEYS_RESOURCE_VERSION
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "FileDescription",  "Hotkeys Editor For C&C: Generals"
            VALUE "ProductVersion",   GENHOTKEYS_RESOURCE_VERSION_STRING
            VALUE "FileVersion",      GENHOTKEYS_RESOURCE_VERSION_STRING
            VALUE "ProductName",      "GenHotkeys"
            VALUE "InternalName",     "GenHotkeys"
            VALUE "OriginalFilename", "Editor.exe"
            VALUE "CompanyName",      GENHOTKEYS_AUTHORS
            VALUE "LegalCopyright",   GENHOTKEYS_COPYRIGHT
            VALUE "Licence",          "GNU GPL v3"
            VALUE "Info",             "https://github.com/MahBoiDeveloper/GenHotkeys"
            VALUE "Comment",          "GenHotkeys"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
